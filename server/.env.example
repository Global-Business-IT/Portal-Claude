# API key de Anthropic de la empresa. Vive SOLO en el servidor.
ANTHROPIC_API_KEY=

# Modelo de Claude a usar (cámbialo aquí sin tocar código)
CLAUDE_MODEL=claude-sonnet-4-5
MAX_OUTPUT_TOKENS=4096

PORT=3000
NODE_ENV=production
# Detrás de un proxy/balanceador (nginx, Render, etc.) pon 1
TRUST_PROXY=0

# Sesión: se cierra tras X minutos sin actividad / X horas en total
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# Ruta de la base de datos SQLite
DB_PATH=./data/portal.db

# Solo para probar sin API key ni gasto: respuestas simuladas
# CLAUDE_MOCK=1

# ---------- Skills de la empresa (desde GitHub) ----------
# Repositorio con las skills (URL https:// SIN usuario ni contraseña)
SKILLS_REPO_URL=
SKILLS_REPO_BRANCH=main
# Token de solo lectura (fine-grained PAT: acceso solo a ese repo, permiso "Contents: Read")
SKILLS_REPO_TOKEN=
SKILLS_DIR=./data/skills-repo
SKILLS_SUBDIR=.claude/skills
# Secreto del webhook de GitHub (aviso automático al hacer push). Genera uno largo y aleatorio.
GITHUB_WEBHOOK_SECRET=
# Respaldo: sincroniza cada X minutos aunque no llegue el aviso
SYNC_INTERVAL_MIN=10

# Límites por ejecución de skill
SKILL_MAX_TURNS=25
SKILL_MAX_BUDGET_USD=1
SKILL_TIMEOUT_SEC=300
SKILL_MAX_CONCURRENT=3
# SKILL_MODEL=
WORK_DIR=./data/work
OUTPUTS_DIR=./data/outputs
OUTPUT_TTL_HOURS=24

# ---------- Conversión de adjuntos a Markdown (MarkItDown) ----------
# Requiere Python 3.10+ y:  pip install "markitdown[pdf,docx,pptx,xlsx,xls]"
# Si no está instalado, las skills reciben los archivos originales sin convertir.
# En Windows, si "markitdown" no está en el PATH, pon la ruta completa (p. ej. C:\Users\TU_USUARIO\AppData\Local\Programs\Python\Python312\Scripts\markitdown.exe)
# MARKITDOWN_BIN=markitdown
# MARKITDOWN_ENABLED=1
# MARKITDOWN_TIMEOUT_SEC=60
# MARKITDOWN_MAX_CHARS=400000

# Scripts de skills en modo "restringido" (sin sandbox; útil en Windows).
# Por defecto: activado solo en Windows. Pon 1 para forzar, 0 para desactivar.
# SKILLS_ALLOW_RESTRICTED=1
# Intérpretes permitidos para lanzar los scripts de la skill (separados por coma)
# SKILL_SCRIPT_INTERPRETERS=python,python3,py,node
# Hosts a los que pueden conectarse los scripts Python escritos por Claude (modo restringido)
# SKILL_SCRIPT_HOSTS=kaffqbjzgkoxzkrocovp.supabase.co
# Módulos Python permitidos en esos scripts (reemplaza la lista por defecto)
# SKILL_SCRIPT_MODULES=docx,openpyxl,PIL,json,re,sys,os,pathlib,datetime,gbit_docx_core,urllib,requests

# Modo "Aislados (sandbox)": dominios a los que pueden conectarse los scripts (separados por coma). Vacío = sin red.
# Para gbit-doc-iso9001 (consulta el Supabase de GBIT, solo lectura):
# SKILL_SANDBOX_DOMAINS=kaffqbjzgkoxzkrocovp.supabase.co

# Base de datos de producción (Supabase Postgres). Si se deja vacío, usa SQLite local (DB_PATH).
# Supabase → botón Connect → "Transaction pooler" → copia la URI y reemplaza [YOUR-PASSWORD] por la contraseña de la base.
# DATABASE_URL=postgresql://postgres.xxxx:CONTRASEÑA@aws-0-REGION.pooler.supabase.com:6543/postgres
# PG_POOL_MAX=3

# --- Despliegue en Vercel (las variables se configuran en el panel de Vercel, no en este archivo) ---
# Se detecta solo (VERCEL=1): carpetas de trabajo en /tmp, skills por la API de GitHub (sin git),
# archivos generados en Supabase Storage (bucket privado "portal-files") y tope de 4 MB por subida.
# Obligatorias: ANTHROPIC_API_KEY, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL, PG_POOL_MAX=1,
#   SKILLS_REPO_URL=https://github.com/ORG/REPO, SKILLS_REPO_TOKEN (solo lectura), CRON_SECRET (texto largo aleatorio),
#   VERCEL_SUPPORT_LARGE_FUNCTIONS=1 (el binario del SDK pesa ~250 MB)
# SKILLS_FETCH=api|git      (por defecto: api en Vercel, git en local)
# STORAGE=supabase|local    (por defecto: supabase en Vercel, local en el resto)
# STORAGE_BUCKET=portal-files
